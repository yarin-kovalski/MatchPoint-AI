{
  "name": "matchpoint-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Smart tennis motion trainer POC using phone sensors, Socket.io, and TypeScript.",
  "scripts": {
    "all": "npm start",
    "build": "tsc -p server/tsconfig.json && tsc -p client-mobile/tsconfig.json && tsc -p client-pc/tsconfig.json",
    "build:server": "tsc -p server/tsconfig.json",
    "build:mobile": "tsc -p client-mobile/tsconfig.json",
    "build:pc": "tsc -p client-pc/tsconfig.json",
    "dev": "tsc -p server/tsconfig.json && tsc -p client-mobile/tsconfig.json && tsc -p client-pc/tsconfig.json && node dist/server/index.js",
    "start": "powershell -NoProfile -ExecutionPolicy Bypass -File ./start.ps1",
    "start:server": "node dist/server/index.js",
    "test:phase-b": "tsc -p tests/tsconfig.json && node --test dist-tests/tests/phase-b.test.js",
    "test:phase-c": "tsc -p tests/tsconfig.json && node --test dist-tests/tests/phase-c.test.js",
    "test:phase-d": "tsc -p tests/tsconfig.json && node --test dist-tests/tests/phase-d.test.js",
    "test:phase-d1": "tsc -p tests/tsconfig.json && node --test dist-tests/tests/phase-d1.test.js",
    "test:app": "tsc -p tests/tsconfig.json && node --test dist-tests/tests/*.test.js",
    "test:kanban": "node --test scripts/kanban/*.test.mjs",
    "test": "npm run test:app && npm run test:kanban",
    "kanban:sync": "node scripts/kanban/run-kanban.mjs",
    "kanban:check": "node scripts/kanban/sync-trello.mjs --check",
    "kanban:status": "node scripts/kanban/sync-trello.mjs --status",
    "tunnel": "tools\\cloudflared.exe tunnel --edge-ip-version 4 --url http://localhost:3000",
    "tunnel:localtunnel": "lt --port 3000 --local-host 127.0.0.1",
    "typecheck": "tsc -p server/tsconfig.json && tsc -p client-mobile/tsconfig.json && tsc -p client-pc/tsconfig.json"
  },
  "dependencies": {
    "selfsigned": "^5.5.0",
    "socket.io": "^4.7.5",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/three": "^0.184.1",
    "localtunnel": "^2.0.2",
    "typescript": "^5.5.3"
  }
}
